PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_NAME=agnus
DB_USER=root
# Mesma senha de MYSQL_ROOT_PASSWORD no .env da raiz
DB_PASSWORD=
DB_LOGGING=false

JWT_SECRET=
JWT_EXPIRES_IN=1h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://SEU-DOMINIO/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_STATE_SECRET=

FRONTEND_URL=https://localhost

MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_INDEX=produtos

# Definido no docker-compose; so e preciso fora do Docker
REDIS_URL=redis://redis:6379

# debug | info | warn | error | silent
LOG_LEVEL=info
