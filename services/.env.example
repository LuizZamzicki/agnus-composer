PORT=3000

# Em producao, use production: desliga os retornos de desenvolvimento do login Google (Expo e localhost)
NODE_ENV=development

DB_HOST=mysql
DB_PORT=3306
DB_NAME=agnus
DB_USER=root
# Mesma senha de MYSQL_ROOT_PASSWORD no .env da raiz
DB_PASSWORD=
DB_LOGGING=false

# Só a identidade usa o JWT_SECRET (marca da sessão; e assinatura, se não houver chaves).
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Par ES256 dos tokens: a privada fica só na identidade, os outros serviços só conferem com a
# pública. Gere com: node services/scripts/gerar-chaves-jwt.cjs services/.env
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback público (ngrok), usado pelo login do app mobile
GOOGLE_REDIRECT_URI=https://SEU-DOMINIO/auth/google/callback
# Callback do site, pelo nginx local (evita a página de aviso do ngrok)
GOOGLE_REDIRECT_URI_WEB=https://localhost/api/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_STATE_SECRET=

FRONTEND_URL=https://localhost

MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_INDEX=produtos

# Definido no docker-compose; so e preciso fora do Docker
REDIS_URL=redis://redis:6379

# debug | info | warn | error | silent
LOG_LEVEL=info

# ---- Mercado Pago (checkout proprio: PIX e cartao) ----
# Credenciais em https://www.mercadopago.com.br/developers/panel/app -> sua aplicacao -> Credenciais.
# Use as de TESTE (da conta vendedora de teste; comecam com APP_USR-) ate a loja estar pronta.
# Com elas, o pagador precisa ser a conta COMPRADORA de teste. Para receber de verdade, troque pelas de producao.
# So o servico pedidos recebe o access token e a chave do webhook (o docker-compose apaga dos outros).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Opcional. Webhooks -> Configurar notificacoes: evento "Pagamentos"; a chave secreta gerada la vai aqui.
MP_WEBHOOK_SECRET=
# Endereco publico (https) que o Mercado Pago chama. Com o tunel ngrok: https://<seu-dominio>.ngrok-free.dev/pagamentos/webhook
# Sem ele (ex.: so localhost), o site confere o status do pagamento pela consulta.
MP_NOTIFICATION_URL=

# ---- Programa de afiliados (servico afiliados) ----
# Segredo do servico (minimo 32 caracteres): assina o cookie de clique e cifra as credenciais da API.
# Gere com: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Trocar invalida os cliques em andamento e as credenciais de API ja geradas.
AFILIADOS_SEGREDO=
# Janela de atribuicao (dias entre o clique e a compra) e prazo para aprovar a comissao depois da entrega.
AFILIADOS_JANELA_DIAS=7
AFILIADOS_PRAZO_APROVACAO_DIAS=7
# Taxa (%) usada enquanto a equipe nao cadastra a regra "padrao" no admin.
AFILIADOS_TAXA_PADRAO=10
# Limite da API do afiliado por AppID, por hora.
AFILIADOS_LIMITE_HORA=2000

# ---- YouDraw: producao e envio dos pedidos (servicos pedidos e catalogo) ----
# API Comercial (beta privada): https://docs.youdraw.com.br/  A conta precisa estar liberada pela YouDraw.
# Chave: painel YouDraw > Menu da conta > API > Chaves > Nova chave (PRODUCAO, comeca com yd_live_).
# Escopos: orders:write, orders:read, catalog:read. O ambiente de teste (yd_test_) ainda nao cria pedidos.
# Vazio = integracao desligada: os pedidos pagos ficam como "manual" e sao feitos a mao no painel.
# ATENCAO: com a chave, todo pedido PAGO na loja vira um pedido REAL na YouDraw (aguardando pagamento la).
YOUDRAW_API_KEY=
# YOUDRAW_API_URL=https://api.youdraw.com.br/api/v1
# Webhook: painel > Menu da conta > API > Webhooks; URL https://<seu-dominio-ngrok>/youdraw/webhook,
# canal "api", eventos order.status_changed e order.tracking_updated. O segredo (whsec_...) vai aqui.
YOUDRAW_WEBHOOK_SECRET=

# ---- Devolucoes (servico pedidos) ----
# Prazos contados da entrega. Arrependimento e "tamanho nao serviu": 7 dias (CDC art. 49).
# Defeito e peca errada: 90 dias (CDC art. 26, II). So aumente; o minimo legal e esse.
DEVOLUCAO_PRAZO_ARREPENDIMENTO_DIAS=7
DEVOLUCAO_PRAZO_DEFEITO_DIAS=90

# ---- Rastreio da YouDraw (servico pedidos) ----
# Token da pagina de rastreio da loja: o codigo no fim do link https://app.youdraw.com.br/rastrear/<token>.
# Com ele, "Meus pedidos" mostra o rastreio ja pesquisado (pelo numero do pedido na YouDraw, se a
# equipe informar no admin, ou pelo e-mail do cliente). Vazio: o botao de rastreio nao aparece.
YOUDRAW_LOJA_TOKEN=

# ---- E-mail (servico notificacoes) ----
# Avisos de pedido por e-mail: recebido/aguardando pagamento, pago, enviado, entregue e cancelado.
# Sem SMTP_HOST o envio fica desligado (o aviso dentro do site continua).
# Desenvolvimento: SMTP_HOST=mailpit e SMTP_PORT=1025 (sem usuario/senha), com COMPOSE_PROFILES=email-local
#   no .env da raiz; os e-mails aparecem em http://localhost:8025.
# Producao (e-mail da loja na Hostinger): SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_SECURE=true,
#   SMTP_USER=contato@agnusfit.com e SMTP_PASS=<senha da caixa no hPanel -> E-mails>.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<conta>@gmail.com e SMTP_PASS=<senha de app>
#   (Conta Google -> Seguranca -> Verificacao em duas etapas -> Senhas de app). A senha normal nao funciona.
# Outros provedores (Brevo, Resend, SES, Zoho...): use o host, a porta e as credenciais SMTP deles.
SMTP_HOST=
SMTP_PORT=587
# true = TLS direto (porta 465); vazio decide pela porta.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remetente exibido. No Gmail precisa ser a propria conta (ou um alias verificado nela).
EMAIL_FROM="Agnus <contato@agnusfit.com>"
# Opcional: e-mails da equipe (separados por virgula) que recebem "novo pedido" e "pedido pago".
EMAIL_EQUIPE=contato@agnusfit.com

# ---- Shopify headless: DESATIVADO (servico loja fora do docker-compose; ver services/loja/README.md) ----
# Shopify headless (servico loja). Dominio .myshopify.com da loja e token da Storefront API
# (app "Headless" no admin do Shopify). Prefira o token privado: ele fica so no servidor.
# SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Alternativa: token publico (se o privado estiver preenchido, ele e ignorado)
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_PAIS=BR
# SHOPIFY_IDIOMA=PT_BR
# 
# Admin API (so leitura de pedidos, para "Meus pedidos"). Use client id + secret de um app do
# Dev Dashboard com o escopo read_orders, ou um token fixo de app personalizado antigo.
# Também aceita os nomes SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET.  Escopos: read_orders (e read_all_orders para pedidos com mais de 60 dias).
# SHOPIFY_ADMIN_CLIENT_ID=
# SHOPIFY_ADMIN_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=
